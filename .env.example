# ---------------------------------------------------------------------------
# Value Spread Betting — configuration
# Copy this file to ".env" and fill in your values.
# ---------------------------------------------------------------------------

# Web server port
PORT=3000

# How often to refresh odds and scan for opportunities (seconds)
POLL_INTERVAL_SECONDS=120

# Minimum edge required to count as an opportunity (0.05 = 5%)
EDGE_THRESHOLD=0.05

# Odds data source. One of:
#   demo      -> built-in realistic sample data (works offline, great for testing)
#   oddsapi   -> RECOMMENDED real data via the-odds-api.com (bet365 vs sportsbet,
#                many sports, h2h + line + totals, includes in-play). Needs a key.
#   live      -> experimental direct scrapers (sportsbet + bet365). Fragile.
ODDS_SOURCE=demo

# ---- The Odds API settings (used when ODDS_SOURCE=oddsapi) -----------------
# Free key (500 credits/month) from https://the-odds-api.com
ODDS_API_KEY=
# Regions to pull books from. "au" covers sportsbet. Add ",uk" if you need
# wider bet365 coverage (note: each extra region multiplies credit cost).
ODDS_API_REGIONS=au
# Markets to analyse. More markets = more opportunities = more credits/scan.
ODDS_API_MARKETS=h2h,spreads,totals
# Gold-standard reference book (priority list; first one quoting a game is used).
REFERENCE_BOOK=bet365,pinnacle
# Book you place the bet on.
TARGET_BOOK=sportsbet

# Discord Incoming Webhook URL. Create one in:
#   Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
# Leave blank to disable Discord notifications (the website still works).
DISCORD_WEBHOOK_URL=

# Which sports to scan (comma separated keys understood by the scrapers).
# Examples: afl,nrl,soccer_epl
SPORTS=afl,nrl,soccer_epl

# De-vig method used to turn bet365 odds into "true" probabilities.
#   multiplicative -> proportional margin removal (recommended, default)
#   none           -> use raw 1/odds (overstates probabilities, less accurate)
DEVIG_METHOD=multiplicative
