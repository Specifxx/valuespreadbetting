# ---------------------------------------------------------------------------
# Value Spread Betting — configuration
# Copy this file to ".env" and fill in your values.
# ---------------------------------------------------------------------------

# Web server port
PORT=3000

# How often to refresh odds and scan for opportunities (seconds).
# 3600 = once an hour, sized for The Odds API free tier (500 credits/month).
# Lower it (and/or upgrade your plan) for more frequent scans.
POLL_INTERVAL_SECONDS=3600

# Minimum edge required to count as an opportunity (0.03 = 3%)
EDGE_THRESHOLD=0.03

# Odds data source. One of:
#   demo      -> built-in realistic sample data (works offline, great for testing)
#   oddsapi   -> RECOMMENDED real data via the-odds-api.com (bet365 vs sportsbet,
#                many sports, h2h + line + totals, includes in-play). Needs a key.
#   live      -> experimental direct scrapers (sportsbet + bet365). Fragile.
# Set this to "oddsapi" once you've pasted your key below.
ODDS_SOURCE=oddsapi

# ---- The Odds API settings (used when ODDS_SOURCE=oddsapi) -----------------
# Free key (500 credits/month) from https://the-odds-api.com
ODDS_API_KEY=
# Regions to pull books from. "au" covers sportsbet. Add ",uk" if you need
# wider bet365 coverage (note: each extra region multiplies credit cost).
ODDS_API_REGIONS=au
# Markets to analyse. Free-tier friendly default = h2h only (1 credit/sport/scan).
# Add spreads,totals for far more markets once you're on a paid plan.
ODDS_API_MARKETS=h2h
# Gold-standard reference book (priority list; first one quoting a game is used).
REFERENCE_BOOK=bet365,pinnacle
# Australian books to hunt for value on (we bet at whichever beats the fair
# price). Adding more books costs NO extra API credits.
TARGET_BOOKS=sportsbet,tab,neds,ladbrokes_au,pointsbetau,unibet,betright,bluebet,tabtouch,topsport,playup

# Stop auto-scanning once this many API credits remain (protects your quota).
# Manual "Refresh" in the dashboard still forces a scan.
MIN_CREDITS_RESERVE=20

# Discord Incoming Webhook URL. Create one in:
#   Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
# Leave blank to disable Discord notifications (the website still works).
DISCORD_WEBHOOK_URL=

# Which sports to scan. Fewer sports = fewer credits/scan on the free tier.
# Add more (nba,nfl,mlb,nhl,soccer_aleague,...) when on a paid plan.
SPORTS=afl,nrl

# De-vig method used to turn bet365 odds into "true" probabilities.
#   multiplicative -> proportional margin removal (recommended, default)
#   none           -> use raw 1/odds (overstates probabilities, less accurate)
DEVIG_METHOD=multiplicative
